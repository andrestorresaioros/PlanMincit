# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planmincit

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin initial user
ADMIN_EMAIL=admin@planmincit.gov.co
ADMIN_PASSWORD=Admin123!Change

# Application
APP_NAME=PlanMinCIT API
APP_VERSION=1.0.0
DEBUG=True
DATABASE_ECHO=False

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# CORS
# BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
